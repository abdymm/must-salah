    "Adjust shifts a time by whole minutes, e.g. to match your mosque. Alerts come 10 min before and at the time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعديل يُزيح الوقت بدقائق كاملة، مثلًا لمطابقة مسجدك. تصل التنبيهات قبل الوقت بـ10 دقائق وعند دخوله."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan menggeser waktu per menit, mis. agar sama dengan masjid Anda. Pengingat muncul 10 menit sebelumnya dan tepat pada waktunya."
          }
        }
      }
    },
