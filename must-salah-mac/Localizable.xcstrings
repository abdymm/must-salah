    "Location access is off. Turn it on in System Settings → Privacy & Security → Location Services, or set a city manually." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الموقع متوقف. فعّله من إعدادات النظام ← الخصوصية والأمن ← خدمات الموقع، أو حدّد المدينة يدويًا."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses lokasi mati. Aktifkan di Pengaturan Sistem → Privasi & Keamanan → Layanan Lokasi, atau atur kota secara manual."
          }
        }
      }
